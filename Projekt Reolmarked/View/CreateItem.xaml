<Window x:Class="Projekt_Reolmarked.View.CreateItem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projekt_Reolmarked.View"
        mc:Ignorable="d"
        Title="CreateItem" Height="450" Width="800">
    <Grid>
        <Button Content="Tilføj vare" Command="{Binding AddItemCommand}"  Width="100" Height="30" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,287,0,0"/>
        <TextBlock Text="Pris:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="324,259,0,0"/>
        <TextBox Text="{Binding Price}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,252,0,0" Width="100" Height="30" RenderTransformOrigin="0.472,-1.912"/>
        <TextBlock Text="ID:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="324,229,0,0"/>
        <TextBox Text="{Binding ItemId}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,222,0,0" Width="100" Height="30" RenderTransformOrigin="0.472,-1.912"/>
        <TextBlock Text="Navn:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="316,198,0,0"/>
        <TextBox Text="{Binding Name}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,191,0,0" Width="100" Height="30" RenderTransformOrigin="0.472,-1.912"/>
        <TextBlock Text="Sælger:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="307,169,0,0"/>
        <TextBox Text="{Binding Seller}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,162,0,0" Width="100" Height="30" RenderTransformOrigin="0.472,-1.912"/>
        <TextBlock HorizontalAlignment="Center" Margin="0,132,0,0" TextWrapping="Wrap" Text="Opret vare" VerticalAlignment="Top"/>

    </Grid>
</Window>
