<Window  x:Class="Projekt_Reolmarked.View.CreateItem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projekt_Reolmarked.View"
        xmlns:vm="clr-namespace:Projekt_Reolmarked.ViewModel"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="CreateItem" Height="450" Width="800">
    
    
  
    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <!-- Heading -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Foreground="DarkRed" Text="Vareoversigt" FontSize="40" FontWeight="Heavy" FontFamily="Verdana" HorizontalAlignment="Center" Margin="20"/>


        <!-- Item lists -->
        <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding ItemViewModel.Items}" SelectedItem="{Binding ItemViewModel.SelectedItem}" Margin="15">

            <ListBox.ItemTemplate>

                <DataTemplate>

                    <Border BorderBrush="Black" BorderThickness="1" Margin="5" Padding="10">

                        <StackPanel>

                            <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold"/>

                            <TextBlock Text="{Binding Price, StringFormat=Pris: {0}kr}" FontSize="15" Margin="0,5,0,5"/>

                            <Image Source="{Binding BarcodeImage}" Width="200" Height="70"/>

                            <TextBlock Text="{Binding Barcode}" HorizontalAlignment="Center" FontSize="10"/>

                        </StackPanel>
                       
                        
                    </Border>
                    
                    
                </DataTemplate>

            </ListBox.ItemTemplate>
       
            
        </ListBox>
        
        <!--Create Items -->

        <Grid Grid.Row="1" Grid.Column="1" Margin="30,0,30,30">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="30"/>

            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--Item name -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Varenavn: " FontSize="20"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ItemViewModel.Name}" Margin="5"/>

            <!--Item price -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Pris:" FontSize="20"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ItemViewModel.Price}" Margin="5"/>

            <!--Item seller -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Sælger: " FontSize="20"/>
            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding SellerViewModel.Sellers}" SelectedItem="{Binding SellerViewModel.SelectedSeller}" Margin="5"/>


            <!-- button "gem varer" -->
            <Button Grid.Row="6" Grid.ColumnSpan="2" Content="Gem varer" Width="120" Height="20" Command="{Binding ItemViewModel.AddItemCommand}"/>
            <Button Grid.Row="6" Content="Slet vare" Width="120" Height="20" Command="{Binding ItemViewModel.RemoveItemCommand}" Grid.Column="1" Margin="19,40,110,-30" />




        </Grid>


    </Grid>
</Window>
