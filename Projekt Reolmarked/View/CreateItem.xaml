<Window x:Class="Projekt_Reolmarked.View.CreateItem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projekt_Reolmarked.View"
        mc:Ignorable="d"
        Title="CreateItem" Height="450" Width="800">
    <Grid>
        <Button Content="Tilføj vare" Command="{Binding AddItemCommand}"  Width="100" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="361,287,0,0"/>
        <TextBlock Text="Pris:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="335,259,0,0"/>
        <TextBox Text="{Binding Price}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="361,252,0,0" Width="100" Height="30" RenderTransformOrigin="0.472,-1.912"/>
        <TextBlock Text="Navn:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="319,219,0,0"/>
        <TextBox Text="{Binding Name}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="361,217,0,0" Width="100" Height="30" RenderTransformOrigin="0.472,-1.912"/>
        <TextBlock Text="Tilhøre sælger:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="264,193,0,0"/>
        <TextBlock HorizontalAlignment="Center" Margin="0,132,0,0" TextWrapping="Wrap" Text="Opret vare" VerticalAlignment="Top"/>
        <ComboBox ItemsSource="{Binding ItemVC}" SelectedItem="{Binding SelectedSeller}" HorizontalAlignment="Left" Margin="351,190,0,0" VerticalAlignment="Top" Width="120"/>

    </Grid>
</Window>
