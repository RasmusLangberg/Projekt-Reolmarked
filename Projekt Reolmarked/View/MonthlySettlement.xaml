<Page x:Class="Projekt_Reolmarked.View.MonthlySettlement"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Projekt_Reolmarked.View"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="MonthlySettlement">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Månedsopgørelse"
                   FontSize="40"
                   FontWeight="Heavy"
                   FontFamily="Verdana"
                   Foreground="DarkGreen"
                   HorizontalAlignment="Center"
                   Margin="20"/>

        <ComboBox Grid.Row="1"
          ItemsSource="{Binding SellerViewModel.Sellers}"
          SelectedItem="{Binding MonthlySettlementViewModel.SelectedSeller}"
          DisplayMemberPath="FirstName"
          Width="250"
          Height="35"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          Margin="10"/>

        <TextBlock Grid.Row="1"
           Text="{Binding MonthlySettlementViewModel.TotalSales, StringFormat='Salg i alt: {0} kr.'}"
           FontSize="20"
           HorizontalAlignment="Center"
           VerticalAlignment="Top"
           Margin="10,70,10,10"/>
        
        <TextBlock Grid.Row="1"
           Text="{Binding MonthlySettlementViewModel.Commission, StringFormat='Provision (10%): {0} kr.'}"
           FontSize="20"
           HorizontalAlignment="Center"
           VerticalAlignment="Top"
           Margin="10,110,10,10"/>
        
        <TextBlock Grid.Row="1"
           Text="{Binding MonthlySettlementViewModel.MonthlyRent, StringFormat='Reolleje næste måned: {0} kr.'}"
           FontSize="20"
           HorizontalAlignment="Center"
           VerticalAlignment="Top"
           Margin="10,150,10,10"/>

        <TextBlock Grid.Row="1"
           Text="{Binding MonthlySettlementViewModel.Payout, StringFormat='Til udbetaling: {0} kr.'}"
           FontSize="20"
           HorizontalAlignment="Center"
           VerticalAlignment="Top"
           Margin="10,190,10,10"/>

        <TextBlock Grid.Row="1"
           Text="{Binding MonthlySettlementViewModel.AmountOwed, StringFormat='Skyldigt beløb: {0} kr.'}"
           FontSize="20"
           HorizontalAlignment="Center"
           VerticalAlignment="Top"
           Margin="10,230,10,10"/>
        
        


        <Button Grid.Row="2"
                Content="🡨 Tilbage"
                Command="{Binding BackButtonCommand}"
                Width="120"
                Height="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="20"/>

    </Grid>

</Page>