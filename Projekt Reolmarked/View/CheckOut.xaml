<Window x:Class="Projekt_Reolmarked.CheckOut"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projekt_Reolmarked" xmlns:viewmodel="clr-namespace:Projekt_Reolmarked.ViewModel"
        mc:Ignorable="d"
        xmlns:vm="clr-namespace:Projekt_Reolmarked.ViewModel"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="CheckOut" Height="600" Width="800">
    
    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />


        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <!-- Heading -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Foreground="DarkRed" Text="Indkøbsliste" FontSize="40" FontWeight="Heavy" FontFamily="Verdana" HorizontalAlignment="Center" Margin="20"/>


        <!-- Item lists -->

        <TextBlock Text="Alle varer" Grid.Row="1" Grid.Column="0" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>


        <ListBox Grid.Row="2" Grid.Column="0" ItemsSource="{Binding ItemViewModel.Items}" SelectedItem="{Binding ItemViewModel.SelectedItem}" Margin="15">

            <ListBox.ItemTemplate>

                <DataTemplate>


                    <StackPanel>

                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold"/>

                        <TextBlock Text="{Binding SellerFullName, StringFormat=Sælger: {0}}" FontSize="15"/>


                        <TextBlock Text="{Binding Price, StringFormat=Pris: {0}kr}" FontSize="15" />

                        <Image Source="{Binding BarcodeImage}" Width="200" Height="70"/>

                        <TextBlock Text="{Binding Barcode}" HorizontalAlignment="Center" FontSize="10"/>

                    </StackPanel>



                </DataTemplate>

            </ListBox.ItemTemplate>


        </ListBox>

        <!-- Shopping cart -->
        <TextBlock Text="Indkøbskurv" Grid.Row="1" Grid.Column="1" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>


            <ListBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding CheckOutViewModel.ShoppingBasket}" Margin="15">

                <ListBox.ItemTemplate>
                    <DataTemplate>

                        <StackPanel>

                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Price, StringFormat=Pris: {0} kr.}"/>

                    </StackPanel>
                        
                       
                    </DataTemplate>
                    
                </ListBox.ItemTemplate>
                
                
            </ListBox>

        <!-- Overall price -->
        <StackPanel Grid.Row="3" Grid.Column="1">

            <TextBlock Text="Samlet pris:" FontSize="20"/>
            <TextBlock Text="{Binding CheckOutViewModel.TotalPrice, StringFormat={}{0:N2} kr.}" Margin="5"/>

        </StackPanel>

        <!-- buttons for add item, remove cart and save sale-->
        <Button Grid.Row="3" Grid.Column="0" HorizontalAlignment="Left" Content="Tilføj varer" Width="120" Height="25" Command="{Binding CheckOutViewModel.AddItemToBasketCommand}" Margin="10"/>
        <Button Grid.Row="3" Grid.Column="0" HorizontalAlignment="Center" Content="Ryd kurv" Width="120" Height="25" Command="{Binding CheckOutViewModel.ClearBasketCommand}" Margin="10"/>
        <Button Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" Content="Køb gennemført" Width="120" Height="25" Command="{Binding CheckOutViewModel.SellItemCommand}" Margin="10"/>


    </Grid>
    
    
</Window>
