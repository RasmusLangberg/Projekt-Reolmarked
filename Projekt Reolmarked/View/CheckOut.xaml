<Window x:Class="Projekt_Reolmarked.CheckOut"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projekt_Reolmarked" xmlns:viewmodel="clr-namespace:Projekt_Reolmarked.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:ItemViewModel}"
        mc:Ignorable="d"
        Title="CheckOut" Height="450" Width="800">
    <Grid>
        <Button Content="Tilføj vare" Command="{Binding AddItemCommand}"  Width="100" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="552,306,0,0"/>
        <TextBlock Text="Pris:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="526,278,0,0"/>
        <TextBox Text="{Binding Price}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="552,271,0,0" Width="100" Height="30" RenderTransformOrigin="0.472,-1.912"/>
        <TextBlock Text="ID:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="526,248,0,0"/>
        <TextBox Text="{Binding ItemId}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="552,241,0,0" Width="100" Height="30" RenderTransformOrigin="0.472,-1.912"/>
        <TextBlock Text="Navn:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="518,218,0,0"/>
        <TextBox Text="{Binding Name}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="552,211,0,0" Width="100" Height="30" RenderTransformOrigin="0.472,-1.912"/>
        <TextBlock Text="Sælger:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="509,188,0,0"/>
        <TextBox Text="{Binding Seller}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="552,181,0,0" Width="100" Height="30" RenderTransformOrigin="0.472,-1.912"/>
    </Grid>
</Window>
