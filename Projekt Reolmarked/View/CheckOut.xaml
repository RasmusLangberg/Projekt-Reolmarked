<Window x:Class="Projekt_Reolmarked.CheckOut"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projekt_Reolmarked" xmlns:viewmodel="clr-namespace:Projekt_Reolmarked.ViewModel"
        mc:Ignorable="d"
        xmlns:vm="clr-namespace:Projekt_Reolmarked.ViewModel"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="CheckOut" Height="450" Width="800">
    <Grid>
        <Button Content="Ryd kurv" Command="{}"  Width="138" Height="23" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="394,357,0,0" />
        <TextBlock Text="Fulde pris " HorizontalAlignment="Left" VerticalAlignment="Top" Margin="596,268,0,0"/>
        <TextBox Text="{Binding TotalPrice}" IsReadOnly="True" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="656,261,0,0" Width="100" Height="30" RenderTransformOrigin="0.472,-1.912"/>
        <TextBlock HorizontalAlignment="Left" Margin="430,82,0,0" TextWrapping="Wrap" VerticalAlignment="Top" RenderTransformOrigin="1.748,1.44" Text="Indkøbskurv" Height="23" Width="66" />
        <ListBox ItemsSource="{Binding ItemViewModel.Items}" SelectedItem="{Binding ItemViewModel.SelectedItem}" DisplayMemberPath="Name" Margin="10,59,462,47"/>
        <TextBlock HorizontalAlignment="Left" Margin="138,34,0,0" TextWrapping="Wrap" VerticalAlignment="Top" RenderTransformOrigin="1.748,1.44" Text="Alle varer" />
        <TextBlock HorizontalAlignment="Left" Margin="376,12,0,0" TextWrapping="Wrap" VerticalAlignment="Top" RenderTransformOrigin="1.748,1.44" Text="Opret Salg" FontWeight="Bold" FontSize="20" />
        <ListBox ItemsSource="{Binding CheckOutViewModel.ShoppingBasket}" Margin="357,110,231,92"/>
        <Button Content="Gennemfør salg" Command="{Binding }"  Width="138" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="637,312,0,0" />
        <Button Content="Tilføj vare til indkøbskurv " Command="{Binding CheckOutViewModel.AddItemToBasketCommand}"  Width="137" Height="23" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="395,385,0,0" />
    </Grid>
</Window>
