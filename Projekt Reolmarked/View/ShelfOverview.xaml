                                <TextBlock Text="{Binding SelectedShelfType, StringFormat='Hyldetype: {0}', TargetNullValue=Hyldetype: Ingen}"  FontSize="18" Height="24" FontWeight="Bold" />
                                <TextBlock Text="{Binding SelectedShelfStatus, StringFormat=Tilgængelighed: \{0\}}" FontSize="18" Height="32" FontWeight="Bold" />

